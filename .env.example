# Segredos reais pertencem à configuração da Vercel ou ao arquivo ignorado .env.local.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
ELO_ADMIN_EMAIL=
# Opcional: configuração inicial de um banco vazio. Sem token, o cadastro inicial fica desabilitado na Vercel.
ELO_SETUP_TOKEN=
# Login corporativo Google: veja GOOGLE-LOGIN.md. Todos são necessários para habilitar o botão.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
